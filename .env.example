PORT=3001
# NODE_ENV=production

# ── Auth / security ─────────────────────────────────────────────────────────
# JWT_SECRET is REQUIRED. Must be >= 32 chars and not "dev_secret".
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_this_to_a_long_random_secret_string

# Encrypts two-factor (TOTP) secrets at rest. REQUIRED in production; a dev key is
# derived from JWT_SECRET when ALLOW_WEAK_SECRETS=true.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# Local development ONLY: tolerate a missing/weak JWT_SECRET / TOTP_ENC_KEY.
# Never set this in production.
# ALLOW_WEAK_SECRETS=true

# Access-token lifetime (short) and refresh-token lifetime (days).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Login lockout: N failed attempts within the window locks the account for
# LOGIN_LOCK_MINUTES (doubling on repeat).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Optional: also deliver the refresh token as an httpOnly cookie (web-only
# deployments). The shipped clients use the response body.
USE_AUTH_COOKIES=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API from a browser.
# Requests with no Origin (native mobile, curl) are always allowed; when
# FRONTEND_PATH is set (desktop bundle) any origin is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Set to the number of proxy hops (e.g. 1) when running behind a load balancer,
# so client IPs (rate limiting, audit) are correct. Leave unset for direct/local.
# TRUST_PROXY=1

# ── Postgres ────────────────────────────────────────────────────────────────
# Base connection URL, no ?schema= here. Each Prisma client (platform singleton,
# per-tenant pool) appends its own schema at runtime via src/db/tenantSchema.js.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CLI-only URLs used by `prisma migrate` (each Prisma project needs a concrete
# schema= target). Runtime code derives the same shape from DATABASE_URL.
PLATFORM_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=platform
TENANT_TEMPLATE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=tenant_template

# Max simultaneously-open PrismaClient instances in the tenant connection pool.
MAX_OPEN_TENANT_PRISMA_CLIENTS=25

# Optional: override the auto-bootstrapped first platform owner account
# (created only if platform_admins is empty).
# PLATFORM_ADMIN_EMAIL=superadmin@platform.local
# PLATFORM_ADMIN_PASSWORD=SuperAdmin@2025

# ── On-prem / desktop licensing (dormant unless LICENSE_REQUIRED=true) ───────
# The hosted SaaS leaves all of this unset.
LICENSE_REQUIRED=false
# Base64 SPKI Ed25519 public key, printed by `npm run license:keygen`.
LICENSE_PUBLIC_KEY=
# Path to the signed license file shipped to the customer.
LICENSE_FILE=./license.lic
# Where the last successful check-in / revocation flag is cached.
LICENSE_STATE_FILE=./license-state.json
# Days the install keeps running after expiry or while unable to reach the server.
LICENSE_GRACE_DAYS=14
# License server base URL for periodic check-ins (optional; omit for pure offline).
LICENSE_SERVER_URL=
LICENSE_PHONE_HOME_HOURS=12
# Vendor signing machine only — path to the Ed25519 private key.
# LICENSE_SIGNING_KEY=./license-keys/private.pem
