{
  "name": "school-management-api",
  "version": "1.0.0",
  "description": "REST API for School Management System",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/db/seed.js",
    "clean": "node src/db/clean.js",
    "prisma:platform:migrate": "prisma migrate dev --schema=prisma/platform/schema.prisma",
    "prisma:tenant:migrate": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "migrate:data": "node scripts/migrate-to-postgres.js",
    "migrate:verify": "node scripts/verify-migration.js",
    "verify:auth": "node scripts/verify-auth.js",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "6.19.3"
  }
}
