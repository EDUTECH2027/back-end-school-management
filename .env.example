PORT=3001
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Postgres — base connection URL, no ?schema= here. Each Prisma client (platform
# singleton, per-tenant pool) appends its own schema at runtime via
# src/db/tenantSchema.js. See prisma/platform/schema.prisma and prisma/tenant/schema.prisma.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CLI-only URLs used by `prisma migrate` (each Prisma project needs a concrete
# schema= target to diff/migrate against at build time). Runtime code never reads
# these directly — it derives the same shape from DATABASE_URL. Keep both pointed
# at the same server as DATABASE_URL.
PLATFORM_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=platform
TENANT_TEMPLATE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=tenant_template

# Max simultaneously-open PrismaClient instances in the tenant connection pool
# (LRU-evicted past this cap). Mirrors the old MAX_OPEN_TENANT_DBS.
MAX_OPEN_TENANT_PRISMA_CLIENTS=25

# Optional: override the auto-bootstrapped first platform owner account
# (created only if platform_admins is empty).
# PLATFORM_ADMIN_EMAIL=superadmin@platform.local
# PLATFORM_ADMIN_PASSWORD=SuperAdmin@2025
