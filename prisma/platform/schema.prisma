generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum BillingCycle {
  monthly
  yearly
}

enum SchoolStatus {
  active
  inactive
  suspended
  archived
}

enum PlatformRole {
  platform_owner
  platform_admin
}

enum LogActorType {
  platform_admin
  system
}

model SubscriptionPlan {
  id            String       @id
  name          String       @unique
  price         Float        @default(0)
  billing_cycle BillingCycle @default(monthly)
  max_students  Int?
  max_teachers  Int?
  features      Json         @default("[]")
  is_custom     Boolean      @default(false)
  created_at    DateTime?    @default(now())
  updated_at    DateTime?    @default(now())

  schools          School[]
  default_settings PlatformSetting[]

  @@map("subscription_plans")
}

model School {
  id                   String       @id
  name                 String
  code                 String?
  address              String?
  phone                String?
  email                String
  admin_name           String
  admin_email          String
  plan_id              String?
  status               SchoolStatus @default(active)
  subscription_started DateTime?    @default(now())
  subscription_expiry  DateTime?
  created_at           DateTime?    @default(now())
  updated_at           DateTime?    @default(now())

  plan      SubscriptionPlan? @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  directory UserDirectory[]

  @@index([status])
  @@index([plan_id])
  @@map("schools")
}

model PlatformAdmin {
  id            String       @id
  name          String
  email         String       @unique
  password_hash String
  role          PlatformRole @default(platform_admin)
  initials      String
  permissions   Json         @default("[]")

  // Session kill-switch: bumped on password change / forced logout so any
  // access token minted before the bump is rejected on its next use.
  token_version Int @default(0)

  // Login throttling / lockout
  failed_login_count   Int       @default(0)
  locked_until         DateTime?
  last_failed_login_at DateTime?

  // Two-factor (TOTP). Secret is AES-256-GCM ciphertext, never plaintext.
  totp_secret      String?
  totp_enabled     Boolean   @default(false)
  totp_enrolled_at DateTime?
  recovery_codes   Json? // [{ hash, used_at }]

  created_at    DateTime?    @default(now())
  updated_at    DateTime?    @default(now())

  @@map("platform_admins")
}

/// One row per issued refresh token, for both platform and tenant subjects.
/// Central (platform DB) so it survives tenant connection-pool eviction and
/// covers every scope with one revocation path.
model AuthRefreshToken {
  id             String    @id
  subject_type   String // 'platform' | 'tenant'
  subject_id     String
  school_id      String?
  family_id      String // rotation lineage; reuse of a revoked token kills the family
  token_hash     String    @unique // sha-256 of the raw token
  user_agent     String?
  ip             String?
  expires_at     DateTime
  revoked_at     DateTime?
  replaced_by_id String?
  created_at     DateTime  @default(now())
  last_used_at   DateTime?

  @@index([subject_type, subject_id])
  @@index([family_id])
  @@map("auth_refresh_tokens")
}

model UserDirectory {
  email      String    @id
  school_id  String
  role       String?
  updated_at DateTime? @default(now())

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@map("user_directory")
}

model SystemLog {
  id          String       @id
  actor_type  LogActorType @default(platform_admin)
  actor_id    String?
  actor_name  String?
  action      String
  target_type String?
  target_id   String?
  meta        Json?
  created_at  DateTime?    @default(now())

  @@index([created_at])
  @@map("system_logs")
}

model PlatformAnnouncement {
  id         String    @id
  title      String
  body       String
  is_pinned  Boolean   @default(false)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())

  @@map("platform_announcements")
}

model PlatformSetting {
  id              String    @id
  platform_name   String    @default("School Management System")
  logo_url        String?
  support_email   String?
  default_plan_id String?
  updated_at      DateTime? @default(now())

  default_plan SubscriptionPlan? @relation(fields: [default_plan_id], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

model Feature {
  id          String  @id
  key         String  @unique
  label       String
  description String?

  @@map("features")
}

/// On-prem / desktop licenses issued by the platform owner. The signed .lic file
/// handed to the customer is the source of truth offline; this table lets the
/// owner list / revoke and receive check-ins.
model IssuedLicense {
  id           String    @id
  school_name  String
  edition      String    @default("on_prem")
  seats        Int?
  max_students Int?
  hardware_id  String?
  instance_id  String?
  issued_at    DateTime  @default(now())
  expires_at   DateTime?
  revoked_at   DateTime?
  last_seen_at DateTime?
  last_seen_ip String?
  notes        String?

  @@index([revoked_at])
  @@map("issued_licenses")
}
